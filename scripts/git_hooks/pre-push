#!/usr/bin/env python3
"""Workbench pre-push guard (installed 2026-10-07, user-approved).

Refuses a push that would publish:
  1. private refs: refs/private/*, refs/tags/archive/local-only/*;
  2. branches whose history carries Stata license values (v1.8.11 integration,
     lane, eval and codex review branches);
  3. any new commit whose diff adds a "Serial number:" / "Licensed to:" header
     with a value other than [REDACTED];
  4. any real SHA-256 of a license-bearing raw log listed in a local
     withheld-hash map (local/*/withheld-hash-map.json in this checkout or any
     worktree), which would let the value be recovered by trial.
Holds no secret itself. Bypassing it (--no-verify) is never appropriate here.
"""
import json
import re
import subprocess
import sys
from pathlib import Path

ZERO = "0" * 40
BLOCKED_REFS = [
    re.compile(r"^refs/private/"),
    re.compile(r"^refs/tags/archive/local-only/"),
    re.compile(r"^refs/heads/workbench-v1\.8\.11$"),
    re.compile(r"^refs/heads/(lane|eval|codex)/v1811"),
]
HEADER = re.compile(r"^\+\s*(?:Serial number|Licensed to)\s*:\s*(?!\[REDACTED\])\S")


def git(*args: str) -> str:
    # Committed logs are not all UTF-8; undecodable bytes cannot be a header value.
    out = subprocess.run(["git", *args], capture_output=True, check=True).stdout
    return out.decode("utf-8", errors="replace")


def withheld_hashes() -> set[str]:
    roots = {Path(git("rev-parse", "--show-toplevel").strip())}
    for line in git("worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            roots.add(Path(line[9:]))
    hashes: set[str] = set()
    for root in roots:
        for path in root.glob("local/*/withheld-hash-map.json"):
            try:
                hashes |= {entry["sha256"] for entry in json.loads(path.read_text())["withheld"].values()}
            except (OSError, ValueError, KeyError, TypeError):
                pass
    return hashes


def main() -> int:
    remote = sys.argv[1] if len(sys.argv) > 1 else "origin"
    problems: list[str] = []
    hashes = None
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4:
            continue
        local_ref, local_sha, remote_ref, remote_sha = parts
        if local_sha == ZERO:
            continue  # deletion publishes nothing
        for ref in (local_ref, remote_ref):
            if any(pattern.search(ref) for pattern in BLOCKED_REFS):
                problems.append(f"{ref}: private or license-bearing ref")
        commit = git("rev-parse", f"{local_sha}^{{commit}}").strip() if git("cat-file", "-t", local_sha).strip() == "tag" else local_sha
        if remote_sha != ZERO:
            span = [f"{remote_sha}..{commit}"]
        else:
            span = [commit, "--not", f"--remotes={remote}"]
        patch = git("log", "-p", "--format=COMMIT %H", *span)
        current = None
        for text in patch.splitlines():
            if text.startswith("COMMIT "):
                current = text[7:19]
            elif HEADER.search(text):
                problems.append(f"{remote_ref} {current}: license header value added")
                break
        if hashes is None:
            hashes = withheld_hashes()
        leaked = [h for h in hashes if h in patch]
        if leaked:
            problems.append(f"{remote_ref}: {len(leaked)} withheld raw-log hash(es) present")
    if problems:
        print("pre-push guard refused this push:", file=sys.stderr)
        for problem in dict.fromkeys(problems):
            print("  - " + problem, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
