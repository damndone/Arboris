<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ report.title }}</title>
  </head>
  <body>
    <h1>{{ report.title }}</h1>

    <section>
      <h2>Facts</h2>
      <ul>
        {% for fact in report.facts %}
        <li>{{ fact }}</li>
        {% endfor %}
      </ul>
    </section>

    {% if report.descriptive_stats %}
    <section>
      <h2>Descriptive statistics</h2>
      <table>
        <thead>
          <tr>
            <th>Column</th>
            <th>Dtype</th>
            <th>Count</th>
            <th>Missing</th>
            <th>Missing%</th>
            <th>Unique</th>
            <th>Mean</th>
            <th>Std</th>
            <th>Min</th>
            <th>Max</th>
          </tr>
        </thead>
        <tbody>
          {% for row in report.descriptive_stats %}
          <tr>
            <td>{{ row.column }}</td>
            <td>{{ row.dtype }}</td>
            <td>{{ row.count }}</td>
            <td>{{ row.missing }}</td>
            <td>{{ "%.1f"|format(row.missing_rate * 100) }}%</td>
            <td>{{ row.unique_count }}</td>
            <td>{{ row.mean if row.mean is not none else "—" }}</td>
            <td>{{ row.std if row.std is not none else "—" }}</td>
            <td>{{ row.min if row.min is not none else "—" }}</td>
            <td>{{ row.max if row.max is not none else "—" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
    {% endif %}

    <section>
      <h2>Interpretation</h2>
      <ul>
        {% for claim in report.claims %}
        <li>
          {{ claim.claim }}
          <span data-source-id="{{ claim.source_id }}">Source: {{ claim.source_id }}</span>
          {% if claim.confidence is defined %}
          <span>Confidence: {{ claim.confidence }}</span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>

    {% if report.variable_importance %}
    <section>
      <h2>Variable importance (vs outcome)</h2>
      <table>
        <thead>
          <tr>
            <th>Variable</th>
            <th>Correlation with y</th>
            <th>Best p-value</th>
            <th>Test</th>
            <th>Assessment</th>
          </tr>
        </thead>
        <tbody>
          {% for item in report.variable_importance %}
          <tr>
            <td>{{ item.variable }}</td>
            <td>{{ "%.3f"|format(item.correlation) if item.correlation is not none else "—" }}</td>
            <td>{{ "%.4f"|format(item.best_p_value) if item.best_p_value is not none else "—" }}</td>
            <td>{{ item.test_type or "—" }}</td>
            <td>
              {% if item.best_p_value is none %}
              no data
              {% elif item.best_p_value < 0.01 %}
              significant (1%)
              {% elif item.best_p_value < 0.05 %}
              significant (5%)
              {% elif item.best_p_value < 0.10 %}
              marginal
              {% else %}
              not significant
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
    {% endif %}

    {% if report.statistical_tests %}
    {% set st = report.statistical_tests %}
    <section>
      <h2>Statistical tests</h2>

      {% if st.y_related %}
      <h3>{{ st.y_related | length }} test(s) involving outcome variable</h3>
      <ul>
        {% for test in st.y_related %}
        <li>
          {{ test.label }}: {{ test.interpretation }}
          <span data-source-id="{{ test.source_id }}">Source: {{ test.source_id }}</span>
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      {% if st.other %}
      <h3>{{ st.other | length }} other test(s)
      {% if st.other_truncated and st.other_truncated > 0 %}
      ({{ st.other_truncated }} truncated)
      {% endif %}
      </h3>
      <details>
        <summary>Show all</summary>
        <ul>
          {% for test in st.other %}
          <li>
            {{ test.label }}: {{ test.interpretation }}
            <span data-source-id="{{ test.source_id }}">Source: {{ test.source_id }}</span>
          </li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
    </section>
    {% endif %}

    {% if report.diagnostics %}
    <section>
      <h2>Regression diagnostics</h2>
      {% for model_id, diag in report.diagnostics.items() %}
      <h3>{{ model_id }}</h3>

      {% if diag.vif %}
      <h4>Multicollinearity (VIF)</h4>
      <table>
        <thead><tr><th>Variable</th><th>VIF</th></tr></thead>
        <tbody>
          {% for var, vif in diag.vif.items() %}
          {% if var != 'const' and var != 'const ' %}
          <tr>
            <td>{{ var }}</td>
            <td>
              {% if vif is none %}—{% else %}{{ "%.1f"|format(vif) }}{% endif %}
              {% if vif is not none and vif > 10 %}⚠️ high{% elif vif is not none and vif > 5 %}⚡ moderate{% endif %}
            </td>
          </tr>
          {% endif %}
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% set bp = diag.get("breusch_pagan", {}) %}
      {% if bp and bp.get("lm") is not none %}
      <p>Breusch-Pagan (heteroskedasticity): LM = {{ "%.2f"|format(bp.lm) }}, p = {{ "%.4f"|format(bp.p_value) }}
      {% if bp.p_value < 0.05 %}— significant heteroskedasticity detected{% else %}— homoskedasticity not rejected{% endif %}</p>
      {% endif %}

      {% set dw = diag.get("durbin_watson") %}
      {% if dw is not none %}
      <p>Durbin-Watson (autocorrelation): {{ "%.3f"|format(dw) }}
      {% if dw < 1.5 %}⚠️ positive autocorrelation{% elif dw > 2.5 %}⚠️ negative autocorrelation{% else %}— no autocorrelation concern{% endif %}</p>
      {% endif %}

      {% set jb = diag.get("jarque_bera", {}) %}
      {% if jb and jb.get("statistic") is not none %}
      <p>Jarque-Bera (normality): JB = {{ "%.2f"|format(jb.statistic) }}, p = {{ "%.4f"|format(jb.p_value) }}
      {% if jb.p_value < 0.05 %}— residuals are not normally distributed{% else %}— residuals appear normal{% endif %}</p>
      {% endif %}

      {% set cd = diag.get("cooks_distance", {}) %}
      {% if cd and cd.get("max") is not none %}
      <p>Cook's distance: max = {{ "%.4f"|format(cd.max) }}, threshold = {{ "%.4f"|format(cd.threshold) }}.
      {{ cd.n_high }} observation(s) exceed the screening threshold.
      {% if cd.get("n_severe") and cd.n_severe > 0 %}
      {% else %}
      No single observation appears to dominate the model (max D &lt; 0.5).
      {% endif %}
      {% if cd.get("leverage_max") is not none %} · max leverage = {{ "%.4f"|format(cd.leverage_max) }}{% endif %}</p>
      {% endif %}

      {% endfor %}
    </section>
    {% endif %}

    <section>
      <h2>Warnings</h2>
      <ul>
        {% for warning in report.warnings %}
        <li>
          {% if warning is mapping %}
          {{ warning.message }}
          <span data-source-id="{{ warning.source_id | default('errors.json') }}">
            Source: {{ warning.source_id | default('errors.json') }}
          </span>
          {% else %}
          {{ warning }}
          <span data-source-id="errors.json">Source: errors.json</span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
  </body>
</html>
