.DS_Store
.worktrees/
__pycache__/
*.py[cod]
*.egg-info/
node_modules/
.venv
.superpowers/

# Vite production build output. Regenerated by `npx vite build` and
# never read at runtime in dev — committing it churns the working
# tree on every build and leaks file hashes into PRs. The previously
# committed copies (frontend/dist/{index.html,assets/*}) are
# untracked in the same commit that introduced this rule.
frontend/dist/

# Agent / tool-specific local config. Not a shared IDE convention
# (we don't track .vscode/ or .idea/ either) — keep local smoke
# harnesses out of the repo. Reusable browser-smoke instructions
# live in docs/, not in tool config files.
.claude/
