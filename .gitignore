.DS_Store
.worktrees/
__pycache__/
*.py[cod]
*.egg-info/
node_modules
.venv
.superpowers/

# Vite production build output. Regenerated by `npx vite build` and
# never read at runtime in dev — committing it churns the working
# tree on every build and leaks file hashes into PRs. The previously
# committed copies (frontend/dist/{index.html,assets/*}) are
# untracked in the same commit that introduced this rule.
frontend/dist/

# Agent / tool-specific local config. Not a shared IDE convention
# (we don't track .vscode/ or .idea/ either) — keep local smoke
# harnesses out of the repo. Reusable browser-smoke instructions
# live in docs/, not in tool config files.
.claude/

# runtime matplotlib cache (not part of the repo)
.matplotlib/

# Local secrets: LLM provider base-url/key/model for /llm/chat (v1.6.11 Ask AI).
# The key must NEVER enter git history — a committed API key is the most common
# leak. Track .env.example (placeholders only) as the documented template; keep
# every real .env variant out. .env is loaded into the environment at launch via
# `set -a; source .env; set +a` (no python-dotenv dependency — config.py reads
# os.environ only).
.env
.env.*
!.env.example

# Vite dependency pre-bundle cache. Regenerated on dev server start,
# never read at runtime — same rationale as frontend/dist/ above.
.vite/

# CI template kept local, NOT activated. Rationale: solo dev on a private
# repo (metered Actions minutes) who already runs the full gate locally before
# every version. The workflow also triggers on push to every branch, which
# would burn the monthly budget fast. Before enabling: `git rm` this ignore
# line and tighten triggers to main-only (push:[main] + pull_request:[main]).
.github/

# Machine-local scratch that must SURVIVE reboots (seeded smoke projects,
# verification fixtures). /tmp is wrong for these: macOS reclaims it, and the
# offline smoke LLM config silently evaporating from /tmp is exactly how a
# "cannot call out" guarantee once expired without anyone noticing. The
# leading slash anchors to the repo root.
/local/

# Local-only design-prototype reference (root-level handoff/ + uiux/): the
# original UI mockups, screenshots, and handoff/QA notes. Kept on disk as a
# reference but deliberately out of the repo (~4M of prototype scratch). The
# leading slash anchors to the repo root so the TRACKED docs/superpowers/handoff/
# tree is unaffected.
/handoff/
/uiux/
