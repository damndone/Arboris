# Ask AI (/llm/chat) LLM provider — v1.6.11 slice A.
#
# Copy this file to `.env` and fill in a real key. `.env` is gitignored;
# NEVER commit a real key. The backend reads these from os.environ, so load
# them into your shell before launching uvicorn:
#
#     set -a; source .env; set +a
#     .venv/bin/python -m uvicorn workbench.api:app --port 8010
#
# Any OpenAI-compatible Chat Completions provider works — swap the three values,
# no code change. Examples:
#   DeepSeek : https://api.deepseek.com          model deepseek-v4-flash | deepseek-v4-pro
#   Zhipu GLM: https://open.bigmodel.cn/api/paas/v4   model glm-4
#   Moonshot : https://api.moonshot.cn/v1        model moonshot-v1-8k
#   OpenAI   : https://api.openai.com/v1         model gpt-4o

WORKBENCH_LLM_BASE_URL=https://api.deepseek.com
WORKBENCH_LLM_API_KEY=sk-replace-me
WORKBENCH_LLM_MODEL=deepseek-v4-flash

# Optional: request timeout in seconds (default 60).
# WORKBENCH_LLM_TIMEOUT_S=60
